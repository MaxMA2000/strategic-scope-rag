# ============================================================================
# Strategic Scope RAG - Environment Configuration
# ============================================================================
# Copy this file to .env.dev (for development) or .env and fill in your actual values
# cp .env.example .env.dev
# 
# The application loads environment files in this order:
# 1. .env.dev (development)
# 2. .env (default)
# 3. .env.local (local overrides)

# ============================================================================
# AZURE OPENAI - REQUIRED
# ============================================================================
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_MINI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small

# ============================================================================
# LANGSMITH - OPTIONAL (Recommended for tracing)
# ============================================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=strategic-scope-rag

# ============================================================================
# SERVICE URLS - For Docker Compose
# ============================================================================
REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333
MEILISEARCH_URL=http://meilisearch:7700

# For local development (without Docker):
# REDIS_URL=redis://localhost:6379
# QDRANT_URL=http://localhost:6333
# MEILISEARCH_URL=http://localhost:7700

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_ENV=development
LOG_LEVEL=INFO
DATA_ROOT=./data

# ============================================================================
# RETRIEVAL PARAMETERS
# ============================================================================
RETRIEVAL_TOP_K_DENSE=50
RETRIEVAL_TOP_K_SPARSE=50
RETRIEVAL_FUSION_TOP_N=30
RETRIEVAL_RERANK_TOP_K=8
RETRIEVAL_SCORE_THRESHOLD=0.45

# ============================================================================
# CHUNKING PARAMETERS
# ============================================================================
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# ============================================================================
# CRAWLING PARAMETERS
# ============================================================================
CRAWL_MAX_DEPTH=3
CRAWL_MAX_PAGES=200
CRAWL_RATE_LIMIT=2.0
CRAWL_USER_AGENT=StrategicScopeRAG/1.0

# ============================================================================
# API SETTINGS
# ============================================================================
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8001

# Add more allowed origins as comma-separated values:
# CORS_ORIGINS=http://localhost:3000,http://localhost:8001,https://your-production-domain.com
